# Store the real file OUTSIDE the web root and repository, readable only by app owner.
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
SESSION_DIRECTORY=/srv/philexcel-private/sessions
RATE_LIMIT_STORAGE_URI=redis://127.0.0.1:6379/4
PORTAL_HOSTS=ai.philexcel.com,enroll.philexcel.com,admin.philexcel.com,axon.philexcel.com
ENTRA_TENANT_ID=REPLACE_WITH_TENANT_GUID
ENTRA_CLIENT_ID=REPLACE_WITH_NEW_PORTAL_APP_ID
ENTRA_CLIENT_SECRET=REPLACE_WITH_PORTAL_APP_SECRET
STAFF_CONFIG=/srv/philexcel-private/staff.json
LIBRARY_CONFIG=/srv/philexcel-private/libraries.json
NAS_HOST=REPLACE_WITH_OFFICE_NAS_HOSTNAME_OR_ADDRESS
ENROLL_GATE_HASH=REPLACE_WITH_HASH
AXON_GATE_HASH=REPLACE_WITH_HASH
DATA_GATE_HASH=REPLACE_WITH_HASH
# Leave empty until Gemini model, billing and data handling are configured.
GEMINI_API_KEY=
GEMINI_MODEL=

ACCESS_DATABASE=/srv/philexcel-private/access.sqlite
